{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "OpenOCD: Debug",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/Debug/Rudder_Infantry_Chassis.elf",
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "openocd",
            "configFiles": [
                "interface/cmsis-dap.cfg",
                "target/stm32f4x.cfg",
            ],
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 20
            },
            "preLaunchTask": "CMake: build"
        }
    ]
}
