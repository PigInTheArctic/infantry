{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "shell",
			"label": "OpenOCD: flash",
			"command": "openocd",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"args": [
				"-f",
				"interface/cmsis-dap.cfg",
				"-f",
				"target/stm32f4x.cfg",
				"-c",
				"program build/Debug/Rudder_Infantry_Chassis.elf verify reset exit"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"dependsOn": "CMake: build",
			"detail": "Download program into STM32",
			"problemMatcher": []
		},
		{
			"type": "shell",
			"label": "CMake: build",
			"command": "cmake",
			"args": [
				"--build",
				"--preset",
				"Debug"
			],
			"group": "build",
			"problemMatcher": [],
			"detail": "Build the Debug preset with CMake"
		}
	]
}
